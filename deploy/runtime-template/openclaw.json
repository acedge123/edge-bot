{
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "workspace": "/app/.openclaw/workspace",
      "model": {
        "primary": "openai/gpt-5.6-luna",
        "fallbacks": ["openai/gpt-5.6-sol"]
      },
      "thinkingDefault": "low",
      "heartbeat": {
        "every": "0m",
        "agentId": "main"
      },
      "contextInjection": "continuation-skip",
      "bootstrapMaxChars": 6000,
      "bootstrapTotalMaxChars": 12000,
      "startupContext": {
        "enabled": false
      },
      "contextLimits": {
        "memoryGetMaxChars": 6000,
        "postCompactionMaxChars": 1200
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m",
        "hardClear": {
          "enabled": true,
          "placeholder": "[Old tool result removed]"
        }
      },
      "compaction": {
        "enabled": true,
        "mode": "safeguard",
        "thinkingLevel": "low",
        "keepRecentTokens": 8000,
        "recentTurnsPreserve": 2,
        "postIndexSync": "off",
        "postCompactionSections": [],
        "maxActiveTranscriptBytes": "1mb",
        "memoryFlush": {
          "enabled": false
        }
      },
      "systemAgent": {
        "agentId": "main"
      }
    },
    "entries": {
      "main": {
        "model": "openai/gpt-5.6-luna",
        "workspace": "/app/.openclaw/workspace"
      },
      "main-light": {
        "model": "openai/gpt-5.6-luna",
        "workspace": "/app/.openclaw/workspace"
      },
      "main-med": {
        "model": "openai/gpt-5.6-sol",
        "workspace": "/app/.openclaw/workspace"
      },
      "main-critical": {
        "model": "openai/gpt-5.6-sol",
        "workspace": "/app/.openclaw/workspace"
      }
    }
  },
  "memory": {
    "search": {
      "enabled": false,
      "provider": "none",
      "rememberAcrossConversations": false,
      "sources": ["memory"]
    }
  },
  "cron": {
    "enabled": false,
    "triggers": {
      "enabled": false
    }
  },
  "skills": {
    "limits": {
      "maxSkillsPromptChars": 8000
    },
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  },
  "session": {
    "reset": {
      "mode": "idle",
      "idleMinutes": 60
    }
  },
  "plugins": {
    "entries": {
      "brave": {
        "enabled": true
      },
      "codex": {
        "enabled": true
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      }
    }
  },
  "env": {
    "vars": {}
  },
  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_HOOK_TOKEN}"
  },
  "gateway": {
    "controlUi": {
      "allowedOrigins": ["https://edge-bot-production.up.railway.app"]
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true,
          "images": {
            "allowUrl": true
          }
        }
      }
    }
  }
}
