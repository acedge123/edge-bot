{
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "workspace": "/app/.openclaw/workspace",
      "model": {
        "primary": "openai/gpt-5.6-luna",
        "fallbacks": ["openai/gpt-5.6-sol"]
      },
      "thinkingDefault": "low",
      "heartbeat": {
        "every": "0m",
        "agentId": "main"
      },
      "contextInjection": "continuation-skip",
      "bootstrapMaxChars": 6000,
      "bootstrapTotalMaxChars": 12000,
      "startupContext": {
        "enabled": false
      },
      "contextLimits": {
        "memoryGetMaxChars": 6000,
        "postCompactionMaxChars": 1200
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m",
        "hardClear": {
          "enabled": true,
          "placeholder": "[Old tool result removed]"
        }
      },
      "compaction": {
        "enabled": true,
        "mode": "safeguard",
        "thinkingLevel": "low",
        "keepRecentTokens": 8000,
        "recentTurnsPreserve": 2,
        "postIndexSync": "off",
        "postCompactionSections": [],
        "maxActiveTranscriptBytes": "1mb",
        "memoryFlush": {
          "enabled": false
        }
      },
      "systemAgent": {
        "agentId": "main"
      }
    },
    "entries": {
      "main": {
        "model": "openai/gpt-5.6-luna",
        "workspace": "/app/.openclaw/workspace",
        "skills": ["secure-gmail", "github", "brave-search", "Agent Browser", "mom-walk-manage", "youtrack-via-repo-c", "small-business-finance-tax", "sponsors-database", "slack", "supabase", "wiki-engine", "google-places"]
      },
      "main-light": {
        "model": "openai/gpt-5.6-luna",
        "workspace": "/app/.openclaw/workspace",
        "skills": ["secure-gmail", "github", "brave-search", "Agent Browser", "mom-walk-manage", "youtrack-via-repo-c", "small-business-finance-tax", "sponsors-database", "slack", "supabase", "wiki-engine", "google-places"]
      },
      "main-med": {
        "model": "openai/gpt-5.6-sol",
        "workspace": "/app/.openclaw/workspace",
        "skills": ["github", "repo-map", "pr-code-review-qa", "cursor-agent", "supabase", "youtrack-via-repo-c", "mom-walk-manage", "Agent Browser", "brave-search", "aws-roles-anywhere", "governance-runtime", "secure-gmail"]
      },
      "main-critical": {
        "model": "openai/gpt-5.6-sol",
        "workspace": "/app/.openclaw/workspace",
        "skills": ["github", "repo-map", "pr-code-review-qa", "cursor-agent", "supabase", "youtrack-via-repo-c", "mom-walk-manage", "Agent Browser", "brave-search", "aws-roles-anywhere", "governance-runtime", "secure-gmail"]
      }
    }
  },
  "memory": {
    "search": {
      "enabled": false,
      "provider": "none",
      "rememberAcrossConversations": false,
      "sources": ["memory"]
    }
  },
  "cron": {
    "enabled": false,
    "triggers": {
      "enabled": false
    }
  },
  "skills": {
    "allowBundled": [],
    "limits": {
      "maxSkillsInPrompt": 12,
      "maxSkillsPromptChars": 2200
    },
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  },
  "session": {
    "reset": {
      "mode": "idle",
      "idleMinutes": 60
    }
  },
  "tools": {
    "deny": ["computer", "sessions_spawn", "subagents", "automations", "skill_workshop", "canvas", "image_generate", "music_generate", "video_generate", "tts", "nodes", "node_exec", "node_inference", "mobile_ui", "conversations_*", "sessions_list", "sessions_history", "sessions_search", "sessions_send", "sessions_yield", "agents_list", "progress_card"]
  },
  "plugins": {
    "entries": {
      "brave": {
        "enabled": true
      },
      "codex": {
        "enabled": true
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      }
    }
  },
  "env": {
    "vars": {}
  },
  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_HOOK_TOKEN}"
  },
  "gateway": {
    "controlUi": {
      "allowedOrigins": ["https://edge-bot-production.up.railway.app"]
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true,
          "images": {
            "allowUrl": true
          }
        }
      }
    }
  }
}
